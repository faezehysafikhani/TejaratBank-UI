# PORT: Port the optional Express server listens on in development/self-hosted mode.
PORT=3030

# ---------------------------------------------------------------------------
# Runtime backend configuration
# ---------------------------------------------------------------------------
# Production API and SignalR origins are NOT configured here.
# After `npm run build`, edit `dist/config/runtime-config.json` (a plain data file) on the target server.
# Leave apiBaseUrl/signalRBaseUrl empty there for same-origin deployment:
#   /api
#   /hubs/...
#
# Development localhost values belong in `.env.development`, not in production config.

# VITE_ALLOWED_API_ORIGINS: optional, comma separated. When set, a cross-origin apiBaseUrl in
# runtime-config.json is accepted only if its origin is listed (the file is checked at start-up).
VITE_ALLOWED_API_ORIGINS=""

# VITE_NEXUS_TENANT_SLUG: optional tenant slug sent with sign-in (multi-tenant installs).
VITE_NEXUS_TENANT_SLUG=""

# VITE_API_TIMEOUT_MS: request timeout in milliseconds (default 30000).
VITE_API_TIMEOUT_MS=""
